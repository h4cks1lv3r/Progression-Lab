  ))
    if (_asText(row['name']).trim().isNotEmpty)
      _asText(row['name']).trim().toLowerCase(),
};

void _requireColumns(
  String table,
  Set<String> available,
  List<String> required,
) {
  final missing = required.where((column) => !available.contains(column));
  if (missing.isNotEmpty) {
    throw FormatException(
      'The FitNotes table $table is missing required fields: '
      '${missing.join(', ')}.',
    );
  }
}

Map<int, _FitNotesExercise> _readExercises(
  Database database,
  String table,
  Set<String> columns,
) {
  final typeColumn = _optionalColumn(
    columns,
    'exercise_type_id',
    fallback: '0',
  );
  final values = <int, _FitNotesExercise>{};
  final sql = 'SELECT ${_quoteIdentifier('_id')} AS ${_quoteIdentifier('_id')}, '
      '${_quoteIdentifier('name')} AS ${_quoteIdentifier('name')}, '
      '$typeColumn FROM ${_quoteIdentifier(table)};';
  for (final row in database.select(sql)) {
    final id = _asInt(row['_id']);
    final name = _asText(row['name']).trim();
    if (id <= 0 || name.isEmpty) continue;
    values[id] = _FitNotesExercise(
      name: name,
      type: _asInt(row['exercise_type_id']),
    );
  }
  return values;
}

Map<int, String> _readWorkoutGroups(
  Database database,
