rainingTable);
    final exerciseColumns = _tableColumns(database, exerciseTable);
    _requireColumns(
      trainingTable,
      trainingColumns,
      const <String>['_id', 'date', 'exercise_id', 'metric_weight', 'reps'],
    );
    _requireColumns(
      exerciseTable,
      exerciseColumns,
      const <String>['_id', 'name'],
    );

    final count = _asInt(
      database
          .select(
            'SELECT COUNT(*) AS row_count FROM '
            '${_quoteIdentifier(trainingTable)};',
          )
          .first['row_count'],
    );
    if (count > maximumTrainingRows) {
      return <String, Object?>{
        'error':
            'The .fitnotes backup contains more than '
            '$maximumTrainingRows training rows and is too large to import safely.',
      };
    }

    final exercises = _readExercises(
      database,
      exerciseTable,
      exerciseColumns,
    );
    final workoutGroups = _readWorkoutGroups(database, tables);
    final workoutTimes = _readWorkoutTimes(database, tables);
    final setComments = _readSetComments(database, tables);
    final workoutComments = _readWorkoutComments(database, tables);
    final rows = _readTrainingRows(
      database,
      table: trainingTable,
      columns: trainingColumns,
      exercises: exercises,
      workoutGroups: workoutGroups,
      workoutTimes: workoutTimes,
      setComments: setComments,
      workoutComments: workoutComments,
    );
    return <String, Object?>{'rows': rows};
  } on FormatException catch (error) {
    return <String, Object?>{'error': '${error.message}'};
  } on FileSystemException {
    return const <String, Object?>{
      'error': 'Progression Lab could not stage the .fitnotes backup for import.',
    };
  } on SqliteException {
    return const <String, Object?>{
      'error': 'The selected .fitnotes backup is not a readable FitNotes database.',
    };
  } on Object {
    return const <String, Object?>{
      'error': 'The selected .fitnotes backup could not be decoded.',
    };
  } finally {
    try {
      database?.close();
    } on Object {
      // The temporary database is read-only and is deleted below.
    }
    try {
      workspace?.deleteSync(recursive: true);
    } on Object {
      // The operating system can remove an abandoned temporary directory later.
    }
  }
}

Map<String, String> _fitNotesTables(Database database) {
  final tables = <String, String>{};
  for (final row in database.select(
    "SELECT name FROM sqlite_master WHERE type = 'table';",
  )) {
    final name = _asText(row['name']).trim();
    if (name.isEmpty || name.toLowerCase().startsWith('sqlite_')) continue;
    tables[name.toLowerCase()] = name;
  }
  return tables;
}

